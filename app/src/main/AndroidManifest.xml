<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed so the notification-reading / polling services survive Android's background kills -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Phase 3 (media support): needed to read the actual image/video/voice
      note FILES that WhatsApp writes under
      Android/media/com.whatsapp/WhatsApp/Media/ - the notification only
      ever gives us a compressed preview at best, never the real file.
      Deliberately chosen over the narrower READ_MEDIA_IMAGES/VIDEO/AUDIO
      trio: WhatsApp is known to drop a .nomedia marker in some of its own
      media subfolders on some devices/versions, which silently excludes
      those files from MediaStore (the narrower permissions only grant
      MediaStore-indexed access) - this app isn't Play-Store-distributed,
      so the stricter Play policy around this permission doesn't apply,
      and raw file access sidesteps that indexing gap entirely.
      Requested manually via Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION
      (see MainActivity), same manual-grant pattern as notification access
      and the accessibility service below.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!--
      FIX (21.8.2026): MANAGE_EXTERNAL_STORAGE only exists as a concept
      on Android 11+ (API 30+). On earlier versions, reading files
      outside the app's own sandbox still requires the classic
      READ_EXTERNAL_STORAGE runtime (dangerous) permission - this was
      missing entirely, which is exactly why every listFiles() call
      silently returned empty on a pre-Android-11 device (confirmed via
      on-device diagnostics: the media folder reported 0 files even for
      pre-existing files a separate file manager could see just fine).
      maxSdkVersion=32 is the standard pattern - API 33+ replaced this
      with the granular READ_MEDIA_* permissions, and this app already
      relies on MANAGE_EXTERNAL_STORAGE there instead.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      FIX (23.8.2026): needed by the new "שמור לקובץ" (save log to
      file) button on API 26-28 only - those versions require the
      classic runtime WRITE_EXTERNAL_STORAGE permission to write into
      the public Downloads folder via direct File access. API 29+
      instead goes through MediaStore.Downloads (see MainActivity's
      saveLogToDownloadsFile()), which needs no permission at all under
      scoped storage - that's the whole point of using it there.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".WaBridgeApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="WA Bridge"
        android:theme="@style/Theme.WaBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          This service reads WhatsApp notifications. It requires the user to
          manually grant "Notification access" in Android Settings - this
          cannot be requested via a normal runtime permission dialog, only
          via Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS (handled in
          MainActivity).
        -->
        <service
            android:name=".WaNotificationListener"
            android:label="WA Bridge Listener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Phase 2: polls ?action=check and drives WhatsApp sending.
          dataSync is the closest official foreground-service type for a
          periodic network-polling background task on Android 14+.
        -->
        <service
            android:name=".PollingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Phase 2: finds the message box / send button inside WhatsApp's
          UI and performs the actual send. Requires the user to manually
          enable it in Settings > Accessibility (same category of manual
          grant as MacroDroid's own Accessibility permission).
        -->
        <service
            android:name=".WaSendAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
