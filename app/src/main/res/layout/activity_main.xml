<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WA Bridge - שלב 1"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="בודק הרשאות..."
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGrantAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="פתח הגדרות גישה להתראות"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="כתובת ה-Web App (Apps Script):"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etWebAppUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://script.google.com/macros/s/AKfy.../exec"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSaveUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="שמור כתובת" />

    <TextView
        android:id="@+id/tvLastEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text=""
        android:textSize="13sp"
        android:textColor="#666666" />

</LinearLayout>
